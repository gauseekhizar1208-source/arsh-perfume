APP_NAME="Arsh Perfume"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=debug

# --- Database (MySQL 8) ---------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=arsh_perfume
DB_USERNAME=arsh_app
DB_PASSWORD=

# --- Sessions / cache / queue ---------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
# Production (HTTPS): set to true
SESSION_SECURE_COOKIE=false
CACHE_STORE=database
QUEUE_CONNECTION=database

# --- Media (product images) -----------------------------------------------
# public = storage/app/public (run `php artisan storage:link`). For cloud: s3 (+ AWS_* below)
MEDIA_DISK=public
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=
AWS_URL=

# --- Mail ------------------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="orders@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Razorpay --------------------------------------------------------------
# Leave blank in local development to use the built-in SIMULATED gateway (never active in production).
# Use rzp_test_* keys to test against Razorpay's sandbox; rzp_live_* keys only when you go live.
# Never commit real keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- First administrator (read ONLY by `php artisan db:seed` / `arsh:create-admin`) ----
# Choose your own strong password, run the seeder once, then DELETE these three lines.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

BCRYPT_ROUNDS=12

# --- Google sign-in (Google OAuth Web application credentials) ---------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an Authorized redirect URI in your Google OAuth client.
# Leave unset to use APP_URL + /auth/google/callback.
# GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
